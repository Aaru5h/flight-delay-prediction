{
  "version": "1.0.0",
  "inner_holdout_days": 14,
  "training": {
    "max_epochs": 30,
    "patience_epochs": 4,
    "warmup_epochs": 1,
    "eval_batch_size": 8192,
    "threads": null
  },
  "preprocessing": {
    "min_category_count": 5,
    "max_embedding_dim": 16,
    "numeric_clip": 8.0
  },
  "search": {
    "hidden_layers": [[128, 64], [256, 128, 64], [512, 256, 128]],
    "dropout": [0.0, 0.4],
    "learning_rate_log10_range": [-3.7, -2.3],
    "weight_decay_log10_range": [-6.0, -3.0],
    "batch_size": [512, 1024, 2048],
    "numeric_encoding": ["linear", "periodic"],
    "periodic_frequencies": [8, 16],
    "periodic_sigma_log10_range": [-1.3, 0.5],
    "positive_weighting": [null, "balanced"]
  },
  "sequence": {
    "gru_hidden": [16, 32, 64],
    "departure_delay_clip_minutes": [-60, 300],
    "weather_hours_scale": 12.0,
    "departure_minutes_scale": 360.0
  }
}
